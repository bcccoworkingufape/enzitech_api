						"description": "Lista todos os slots de repetição (pendentes e concluídos). Use o `treatmentId`/`enzymeId` de um item da resposta nas rotas de preview/salvar repetição."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    const list = pm.response.json();",
									"    if (Array.isArray(list) && list.length > 0) {",
									"        pm.collectionVariables.set(\"experiment_treatment_id\", list[0].treatmentId);",
									"        pm.collectionVariables.set(\"experiment_enzyme_id\", list[0].enzymeId);",
									"    }",
